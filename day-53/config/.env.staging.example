# ==============================================================================
# AURONIX Railway Staging Environment Configuration
# ==============================================================================

# Runtime Environment
ENVIRONMENT=staging
PORT=8001
HOST=0.0.0.0

# Dedicated Staging Data & FAISS Index Isolation
DATA_DIR=/app/data/staging
FAISS_INDEX_PATH=/app/data/staging/faiss_index_staging.bin
DATABASE_URL=sqlite:////app/data/staging/auronix_staging.db

# Authentication Keys (Staging isolated token)
AURONIX_API_KEY=auronix-staging-key-2026

# External AI Provider (Optional in staging, uses deterministic fallback if omitted)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Semantic Caching (Redis staging cluster or internal memory)
REDIS_URL=redis://cache:6379/0
CACHE_KEY_PREFIX=auronix:staging:

# Cross-Origin Frontend Routing
CORS_ORIGINS=https://auronix-frontend-staging.vercel.app,http://localhost:3000

# Rate Limiting
RATE_LIMIT_PER_HOUR=50

# ==============================================================================
# AURONIX Railway Production Environment Configuration
# ==============================================================================

# Runtime Environment
ENVIRONMENT=production
PORT=8001
HOST=0.0.0.0

# Dedicated Production Data & FAISS Index Isolation
DATA_DIR=/app/data/production
FAISS_INDEX_PATH=/app/data/production/faiss_index_production.bin
DATABASE_URL=sqlite:////app/data/production/auronix_production.db

# Authentication Keys (Stored in HashiCorp Vault / Railway Secrets)
AURONIX_API_KEY=auronix-production-vault-key-2026

# External AI Provider
OPENAI_API_KEY=sk-proj-YOUR_PRODUCTION_OPENAI_KEY
OPENAI_MODEL=gpt-4o-mini

# Semantic Caching (Production Redis Enterprise)
REDIS_URL=redis://default:REDIS_PROD_PASSWORD@redis-prod.railway.internal:6379
CACHE_KEY_PREFIX=auronix:prod:

# Cross-Origin Frontend Routing (Only verified Vercel production domain)
CORS_ORIGINS=https://auronix.vercel.app,https://auronix-app.vercel.app

# Rate Limiting
RATE_LIMIT_PER_HOUR=20

## 13. Complete Backend Implementation Architecture

```python
"""AURONIX Enterprise Backend API — Day 45 Core Architecture.

Implements session management, SQLite logging, latency tracking, retrieval scoring,
in-memory rate limiting (20 req/session/hr), API key authentication, and feedback storage.
"""

import os
import time
import uuid
import sqlite3
import logging
from datetime import datetime
from typing import Dict, List, Optional, Tuple, Literal

from fastapi import FastAPI, Depends, HTTPException, Header, status, Request
from fastapi.exceptions import RequestValidationError
from fastapi.responses import JSONResponse
from pydantic import BaseModel, Field, field_validator

# --- Logging & Configuration ---
logger = logging.getLogger("auronix.backend")
DB_PATH = os.environ.get("SQLITE_DB_PATH", "auronix_logs.db")
DEFAULT_DEV_API_KEY = "auronix-secret-key-45"

# --- Pydantic Data Contracts ---
class HealthResponse(BaseModel):
    status: str = "healthy"
    service: str = "AURONIX Private AI Workbench Backend"
    day: int = 45
    timestamp: str

class SessionCreateResponse(BaseModel):
    success: bool = True
    session_id: str
    created_at: str
    message: str = "Session successfully initialized."

class ChatMessage(BaseModel):
    role: Literal["user", "assistant", "system"]
    content: str
    timestamp: str

class SessionDetailResponse(BaseModel):
    success: bool = True
    session_id: str
    message_count: int
    history: List[ChatMessage]

class AskRequest(BaseModel):
    session_id: str = Field(..., description="Active session UUID")
    user_input: str = Field(..., min_length=1, description="Employee question")

    @field_validator("user_input")
    @classmethod
    def validate_input(cls, v: str) -> str:
        if not v or not v.strip():
            raise ValueError("user_input cannot be empty or contain only whitespace.")
        return v.strip()

class AskResponse(BaseModel):
    success: bool = True
    session_id: str
    answer: str
    latency_ms: float
    retrieval_score: float
    timestamp: str

class FeedbackRequest(BaseModel):
    session_id: str
    query_reference: Optional[str] = None
    feedback_type: Literal["grounding_accuracy", "relevance", "hallucination_report", "general"]
    rating: Literal["positive", "negative"]
    comment: Optional[str] = Field(None, max_length=500)

class FeedbackResponse(BaseModel):
    success: bool = True
    feedback_id: int
    message: str = "Feedback recorded successfully in SQLite store."
    timestamp: str

class LogsResponse(BaseModel):
    success: bool = True
    total_logs: int
    logs: List[Dict[str, any]]

# --- SQLite Database Layer ---
def init_db():
    with sqlite3.connect(DB_PATH) as conn:
        c = conn.cursor()
        c.execute("""
            CREATE TABLE IF NOT EXISTS request_logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                session_id TEXT NOT NULL,
                query_text TEXT NOT NULL,
                response_excerpt TEXT NOT NULL,
                latency_ms REAL NOT NULL,
                retrieval_score REAL,
                timestamp TEXT NOT NULL
            );
        """)
        c.execute("""
            CREATE TABLE IF NOT EXISTS feedback_logs (
                id INTEGER PRIMARY KEY AUTOINCREMENT,
                session_id TEXT NOT NULL,
                query_reference TEXT,
                feedback_type TEXT NOT NULL,
                rating TEXT NOT NULL,
                comment TEXT,
                timestamp TEXT NOT NULL
            );
        """)
        conn.commit()

def log_request(session_id: str, query: str, response: str, latency: float, score: float, ts: str):
    try:
        with sqlite3.connect(DB_PATH) as conn:
            c = conn.cursor()
            c.execute(
                "INSERT INTO request_logs (session_id, query_text, response_excerpt, latency_ms, retrieval_score, timestamp) VALUES (?, ?, ?, ?, ?, ?)",
                (session_id, query, response[:200], latency, score, ts)
            )
            conn.commit()
    except Exception as e:
        logger.error("Non-fatal database log failure: %s", e)

# --- Session Management ---
class SessionManager:
    def __init__(self):
        self._sessions: Dict[str, List[Dict[str, str]]] = {}
    def create_session(self) -> str:
        s_id = str(uuid.uuid4())
        self._sessions[s_id] = []
        return s_id
    def validate_session(self, s_id: str):
        if s_id not in self._sessions:
            raise HTTPException(status_code=404, detail=f"Session '{s_id}' not found. Please create a session via POST /sessions.")
    def add_message(self, s_id: str, role: str, content: str):
        self.validate_session(s_id)
        self._sessions[s_id].append({"role": role, "content": content, "timestamp": datetime.utcnow().isoformat() + "Z"})
    def get_history(self, s_id: str):
        self.validate_session(s_id)
        return self._sessions[s_id]

session_manager = SessionManager()

# --- Rate Limiter (20 req / hour) ---
class InMemoryRateLimiter:
    def __init__(self, max_req=20, window_sec=3600.0):
        self.max_req = max_req
        self.window_sec = window_sec
        self._history: Dict[str, List[float]] = {}
    def check_rate_limit(self, s_id: str):
        now = time.time()
        cutoff = now - self.window_sec
        self._history[s_id] = [t for t in self._history.get(s_id, []) if t > cutoff]
        if len(self._history[s_id]) >= self.max_req:
            raise HTTPException(status_code=429, detail="Rate limit exceeded. You can make up to 20 requests per hour for this session.")
        self._history[s_id].append(now)

rate_limiter = InMemoryRateLimiter()

# --- Authentication Dependency ---
def verify_api_key(x_api_key: Optional[str] = Header(None, alias="x-api-key")):
    expected = os.environ.get("AURONIX_API_KEY", DEFAULT_DEV_API_KEY)
    if not x_api_key or not x_api_key.strip():
        raise HTTPException(status_code=401, detail="Missing API key. Please provide a valid 'x-api-key' header.")
    if x_api_key.strip() != expected.strip():
        raise HTTPException(status_code=401, detail="Invalid API key. Access denied.")
    return x_api_key
```


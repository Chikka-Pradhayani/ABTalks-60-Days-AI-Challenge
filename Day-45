CREATE TABLE IF NOT EXISTS request_logs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id TEXT NOT NULL,
    query_text TEXT NOT NULL,
    response_excerpt TEXT NOT NULL,
    latency_ms REAL NOT NULL,
    retrieval_score REAL,
    timestamp TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_requests_session ON request_logs(session_id);

-- 2. Product-Specific Feedback Table
CREATE TABLE IF NOT EXISTS feedback_logs (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    session_id TEXT NOT NULL,
    query_reference TEXT,
    feedback_type TEXT NOT NULL,
    rating TEXT NOT NULL,
    comment TEXT,
    timestamp TEXT NOT NULL
);
CREATE INDEX IF NOT EXISTS idx_feedback_session ON feedback_logs(session_id);
```

